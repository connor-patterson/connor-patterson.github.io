{
  "name": "connor-patterson-portfolio",
  "version": "2.1.0",
  "private": true,
  "description": "PatterOS, Connor Patterson's interactive engineering and game portfolio.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify:pages": "node scripts/verify-pages.mjs",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "check": "npm run format:check && npm run lint && npm test && npm run build:pages && npm run verify:pages && npm run smoke:pages && npm run audit:production",
    "deploy:pages:dry": "ng deploy --dry-run",
    "predeploy:pages": "npm run check",
    "deploy:pages": "ng deploy"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/router": "22.1.2",
    "@fontsource-variable/azeret-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "angular-cli-ghpages": "3.1.0",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
